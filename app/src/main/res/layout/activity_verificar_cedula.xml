<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="#F8FAFC">

    <!-- cabecera -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Validación de Cédulas"
        android:textSize="23sp"
        android:textStyle="bold"
        android:textColor="#047857"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sistema de comprobación de identidad"
        android:textSize="14sp"
        android:textColor="#64748B"
        android:layout_marginBottom="26dp" />

    <!-- seccion de entrada -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="20dp"
        android:elevation="3dp"
        android:layout_marginBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cédula de Ciudadanía:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="10dp" />

        <!-- campo para ingresar el numero -->
        <EditText
            android:id="@+id/txt_cedula"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ej. 1712345678"
            android:inputType="number"
            android:maxLength="10"
            android:background="#F1F5F9"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="17sp"
            android:textColor="#0F172A"
            android:layout_marginBottom="20dp" />

        <!-- boton verificar -->
        <Button
            android:id="@+id/btn_verificar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Verificar Cédula"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- seccion del resultado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="18dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Respuesta:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:layout_marginBottom="8dp" />

        <!-- cuadro de respuesta -->
        <TextView
            android:id="@+id/txt_resultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="55dp"
            android:gravity="center_vertical"
            android:text="Esperando consulta..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#475569" />

    </LinearLayout>

</LinearLayout>
